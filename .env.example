# Local development. Copy to .env. Never commit .env.
DATABASE_URL=postgres://community:community@localhost:5432/community
APP_URL=http://localhost:3000

# 32+ random characters. Generate with: openssl rand -hex 32
SETUP_TOKEN=

# Optional. See the README.
# DATABASE_URL_UNPOOLED=
# BETTER_AUTH_SECRET=
# CLIENT_IP_HEADER=
# DATABASE_CA_CERT=
# DATABASE_TLS_ALLOW_UNVERIFIED=false
# MIGRATE_ON_PREVIEW=false
# VILLAGE_API_URL=
# VILLAGE_APP_URL=
# Email invites and intro notices through Resend. Set both to send email. Without them, admins copy the invite link.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=Northwind <hello@example.com>

# Where the "Source code" link in the app points. Change it if you run a changed copy (AGPL-3.0).
# NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/VillageHQ/community
# RESEND_WEBHOOK_SECRET=whsec_...   Resend's signing secret for /api/email/resend-webhook (bounces, complaints, replies).
# RESEND_REPLY_DOMAIN=   A domain Resend receives email on. With it, members answer the weekly email by replying (HELP 1, NO 2).
# Timed jobs (email retries, expiring intro asks). A long-running server can tick itself:
# JOBS_SELF_TICK=true
# Or a scheduler calls POST /api/jobs/tick every minute with "Authorization: Bearer <secret>":
# JOBS_TICK_SECRET=   32+ random characters. On Vercel, CRON_SECRET works too.
